# ===== DeepSeek 大模型配置 =====
# 在 https://platform.deepseek.com/ 申请 API Key 后填入。
# 不填也能运行：智能体会进入「离线规则模式」，仍可完成检测/溯源/报告，
# 只是攻击研判与建议改用内置模板，而非大模型生成。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ===== IP 溯源配置 =====
# 是否允许联网调用在线 IP 定位 API（ip-api.com，免费、省份级、无需 key）。
# 沙箱/内网环境可设为 false，仅使用离线库与内置演示映射。
GEOIP_ONLINE_ENABLED=true
# 可选：ip2region 离线库路径（提供则优先使用，省份级、纯离线、最快）
# 下载：https://github.com/lionsoul2014/ip2region/blob/master/data/ip2region.xdb
IP2REGION_XDB_PATH=

# ===== 抓包配置 =====
# 真实抓包后端：auto | scapy | tcpdump | simulate
# auto = 优先 scapy，其次 tcpdump，都没有则回退到模拟数据（沙箱默认走模拟）
CAPTURE_BACKEND=auto
CAPTURE_IFACE=
CAPTURE_TIMEOUT=15
CAPTURE_MAX_PACKETS=2000

# ===== 服务配置 =====
APP_HOST=0.0.0.0
APP_PORT=8000
